generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  CITIZEN
  RESEARCHER
  ORGANIZATION_ADMIN
  GOVERNMENT
  MODERATOR
  ADMIN
}

enum OrganizationMemberRole {
  ADMIN
  MEMBER
}

enum AlertSeverity {
  INFO
  WATCH
  WARNING
  EMERGENCY
}

enum AlertStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  RESOLVED
}

enum ReportCategory {
  WATER_POLLUTION
  ILLEGAL_DUMPING
  DEFORESTATION
  WILDLIFE_INCIDENT
  FLOODING
  AIR_POLLUTION
  OTHER
}

enum DatasetCategory {
  WEATHER
  AIR_QUALITY
  WATER
  BIODIVERSITY
  REPORTS
  MONITORING
  GEOSPATIAL
}

enum DatasetAccessPolicy {
  PUBLIC
  LOGIN_REQUIRED
  RESEARCHER
  APPROVED
  GOVERNMENT
}

enum ProviderType {
  GOVERNMENT_AGENCY
  RESEARCH_INSTITUTION
  NGO
  INTERNATIONAL_ORG
  CITIZEN_SCIENCE
  SATELLITE
  IOT_SENSOR
}

enum OrganizationType {
  GOVERNMENT_AGENCY
  RESEARCH_INSTITUTION
  NGO
  COMMUNITY_GROUP
  PRIVATE_COMPANY
  INTERNATIONAL_ORG
  OTHER
}

enum IngestionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AuditAction {
  USER_REGISTER
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_LOGOUT
  USER_ROLE_CHANGE
  USER_DEACTIVATE
  REPORT_SUBMIT
  REPORT_STATUS_CHANGE
  REPORT_COMMENT_ADD
  REPORT_MEDIA_ADD
  ALERT_CREATE
  ALERT_STATUS_CHANGE
  DATASET_ACCESS
  DATASET_DOWNLOAD
  DATASET_UPDATE
  OBSERVATION_SUBMIT
  OBSERVATION_TRUST_CHANGE
  RESTORATION_PROJECT_CREATE
  RESTORATION_PROJECT_UPDATE
  RESTORATION_PROJECT_JOIN
  DATASET_ACCESS_DECISION
}

enum DatasetAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  PAUSED
}

enum RestorationCategory {
  TREE_PLANTING
  WETLAND_RESTORATION
  RIVERBANK_PROTECTION
  MANGROVE
  WASTE_MANAGEMENT
  OTHER
}

enum ObservationCategory {
  BIODIVERSITY
  WATER_QUALITY
  AIR_QUALITY
  LAND_USE
  RESTORATION
}

enum ObservationTrustLevel {
  RESEARCH_GRADE
  COMMUNITY
  UNVERIFIED
  FLAGGED
}

enum NotificationChannel {
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  role         UserRole @default(CITIZEN)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports    CitizenReport[]
  observations Observation[]
  auditEvents AuditEvent[]
  refreshTokens RefreshToken[]
  restorationProjectsCreated RestorationProject[]
  restorationParticipations  RestorationParticipant[]
  datasetAccessRequests DatasetAccessRequest[] @relation("DatasetAccessRequester")
  datasetAccessDecisions DatasetAccessRequest[] @relation("DatasetAccessDecider")
  alertSubscriptions    AlertSubscription[]
  notificationDeliveries NotificationDelivery[]
  reportComments ReportComment[]
  reportMedia    ReportMedia[]
  organizationMemberships OrganizationMembership[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceId   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─── Organizations ────────────────────────────────────────────────────────────

model Organization {
  id          String       @id @default(cuid())
  name        String
  type        OrganizationType
  description String?
  website     String?
  country     String       @default("Bangladesh")
  isVerified  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  providers Provider[]
  restorationProjects RestorationProject[]
  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id             String                  @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationMemberRole @default(MEMBER)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

// ─── Providers ────────────────────────────────────────────────────────────────

model Provider {
  id             String       @id @default(cuid())
  name           String
  type           ProviderType
  country        String       @default("Bangladesh")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  datasets       Dataset[]
  ingestionJobs  IngestionJob[]
}

// ─── Geography ────────────────────────────────────────────────────────────────

model Division {
  id        String     @id @default(cuid())
  name      String     @unique
  bnName    String?
  districts District[]
}

model District {
  id         String   @id @default(cuid())
  name       String
  bnName     String?
  lat        Float?
  lng        Float?
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])

  upazilas Upazila[]
  reports  CitizenReport[]
  alerts   Alert[]
  observations Observation[]
  restorationProjects RestorationProject[]
  occurrences Occurrence[]
  alertSubscriptions AlertSubscription[]

  currentWeatherReadings CurrentWeatherReading[]
  hourlyWeatherForecasts HourlyWeatherForecast[]
  dailyWeatherForecasts  DailyWeatherForecast[]
  airQualityReadings     HourlyAirQuality[]
  floodForecasts         FloodForecast[]

  @@unique([name, divisionId])
  @@index([divisionId])
}

model Upazila {
  id         String   @id @default(cuid())
  name       String
  bnName     String?
  districtId String
  district   District @relation(fields: [districtId], references: [id])

  unions Union[]

  @@unique([name, districtId])
  @@index([districtId])
}

model Union {
  id        String  @id @default(cuid())
  name      String
  bnName    String?
  upazilaId String
  upazila   Upazila @relation(fields: [upazilaId], references: [id])

  @@unique([name, upazilaId])
  @@index([upazilaId])
}

// ─── Datasets ─────────────────────────────────────────────────────────────────

model Dataset {
  id           String              @id @default(cuid())
  name         String
  category     DatasetCategory
  accessPolicy DatasetAccessPolicy @default(PUBLIC)
  source       String
  providerId   String?
  provider     Provider?           @relation(fields: [providerId], references: [id])
  description  String?
  recordCount  Int?
  lastSyncedAt DateTime?
  isPublished  Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  accessRequests DatasetAccessRequest[]

  @@index([category])
  @@index([accessPolicy])
}

model DatasetAccessRequest {
  id          String                     @id @default(cuid())
  datasetId   String
  dataset     Dataset                    @relation(fields: [datasetId], references: [id])
  userId      String
  user        User                       @relation("DatasetAccessRequester", fields: [userId], references: [id])
  status      DatasetAccessRequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?                      @relation("DatasetAccessDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([datasetId, userId])
}

// ─── Reports ──────────────────────────────────────────────────────────────────

model CitizenReport {
  id          String         @id @default(cuid())
  title       String
  description String
  category    ReportCategory @default(OTHER)
  status      ReportStatus   @default(SUBMITTED)
  summary     String?
  reporterId  String?
  reporter    User?          @relation(fields: [reporterId], references: [id])
  districtId  String?
  district    District?      @relation(fields: [districtId], references: [id])
  lat         Float?
  lng         Float?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  statusHistory ReportStatusEvent[]
  comments      ReportComment[]
  media         ReportMedia[]

  @@index([status])
  @@index([category])
  @@index([districtId])
}

model ReportStatusEvent {
  id        String       @id @default(cuid())
  reportId  String
  report    CitizenReport @relation(fields: [reportId], references: [id])
  status    ReportStatus
  note      String?
  createdAt DateTime     @default(now())

  @@index([reportId])
}

model ReportComment {
  id         String        @id @default(cuid())
  reportId   String
  report     CitizenReport @relation(fields: [reportId], references: [id])
  authorId   String
  author     User          @relation(fields: [authorId], references: [id])
  body       String        @db.Text
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([reportId])
  @@index([authorId])
}

model ReportMedia {
  id           String        @id @default(cuid())
  reportId     String
  report       CitizenReport @relation(fields: [reportId], references: [id])
  uploadedById String
  uploadedBy   User          @relation(fields: [uploadedById], references: [id])
  url          String
  mimeType     String?
  fileSize     Int?
  caption      String?
  createdAt    DateTime      @default(now())

  @@index([reportId])
}

// ─── Observations ─────────────────────────────────────────────────────────────

model Observation {
  id          String                 @id @default(cuid())
  category    ObservationCategory
  trustLevel  ObservationTrustLevel  @default(UNVERIFIED)
  description String
  observerId  String?
  observer    User?                  @relation(fields: [observerId], references: [id])
  districtId  String?
  district    District?              @relation(fields: [districtId], references: [id])
  lat         Float?
  lng         Float?
  species     String?
  observedAt  DateTime               @default(now())
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([category])
  @@index([trustLevel])
  @@index([districtId])
}

// ─── Restoration Projects ──────────────────────────────────────────────────────

model RestorationProject {
  id             String               @id @default(cuid())
  title          String
  description    String
  category       RestorationCategory
  status         ProjectStatus        @default(PLANNED)
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  districtId     String?
  district       District?            @relation(fields: [districtId], references: [id])
  startDate      DateTime?
  endDate        DateTime?
  impactSummary  String?
  createdById    String
  createdBy      User                 @relation(fields: [createdById], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  participants RestorationParticipant[]

  @@index([category])
  @@index([status])
  @@index([districtId])
}

model RestorationParticipant {
  id        String             @id @default(cuid())
  projectId String
  project   RestorationProject @relation(fields: [projectId], references: [id])
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  joinedAt  DateTime           @default(now())

  @@unique([projectId, userId])
}

// ─── Biodiversity (GBIF) ───────────────────────────────────────────────────────

model Species {
  id              String   @id @default(cuid())
  gbifKey         Int      @unique
  canonicalName   String
  vernacularName  String?
  kingdom         String?
  phylum          String?
  class           String?
  order           String?
  family          String?
  genus           String?
  iucnStatus      String?
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  occurrences Occurrence[]

  @@index([canonicalName])
}

model Occurrence {
  id                String    @id @default(cuid())
  gbifOccurrenceKey BigInt    @unique
  speciesId         String
  species           Species   @relation(fields: [speciesId], references: [id])
  districtId        String?
  district          District? @relation(fields: [districtId], references: [id])
  lat               Float
  lng               Float
  observedAt        DateTime?
  recordedBy        String?
  basisOfRecord     String?
  createdAt         DateTime  @default(now())

  @@index([speciesId])
  @@index([districtId])
}

// ─── Alerts ───────────────────────────────────────────────────────────────────

model Alert {
  id           String        @id @default(cuid())
  title        String
  description  String
  severity     AlertSeverity @default(INFO)
  status       AlertStatus   @default(DRAFT)
  instructions String?
  districtId   String?
  district     District?     @relation(fields: [districtId], references: [id])
  issuedAt     DateTime      @default(now())
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  deliveries NotificationDelivery[]

  @@index([status])
  @@index([severity])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model AlertSubscription {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  districtId  String?
  // null = nationwide subscription (receives alerts for any district)
  district    District?           @relation(fields: [districtId], references: [id])
  channel     NotificationChannel @default(EMAIL)
  // Minimum alert severity to trigger delivery. A subscriber with minSeverity
  // WARNING receives WARNING and EMERGENCY alerts only.
  minSeverity AlertSeverity       @default(INFO)
  createdAt   DateTime            @default(now())

  // No @@unique here: Postgres treats NULL != NULL in unique indexes, so
  // @@unique([userId, districtId, channel]) would allow duplicate global
  // (districtId IS NULL) subscriptions per user. Uniqueness is enforced in
  // NotificationsService.subscribe() instead.
  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([districtId])
}

model NotificationDelivery {
  id             String              @id @default(cuid())
  subscriptionId String
  // Cascade: deleting a subscription removes its delivery history.
  subscription   AlertSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  alertId        String
  alert          Alert               @relation(fields: [alertId], references: [id])
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  channel        NotificationChannel
  // Address captured at send time — preserved even if the user later changes email.
  address        String
  status         DeliveryStatus      @default(PENDING)
  sentAt         DateTime?
  failedAt       DateTime?
  error          String?
  createdAt      DateTime            @default(now())

  @@index([alertId])
  @@index([userId])
  @@index([status])
}

// ─── Ingestion ────────────────────────────────────────────────────────────────

model IngestionJob {
  id         String          @id @default(cuid())
  providerId String
  provider   Provider        @relation(fields: [providerId], references: [id])
  status     IngestionStatus @default(QUEUED)
  startedAt  DateTime?
  endedAt    DateTime?
  errorMsg   String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([providerId])
  @@index([status])
}

// ─── Flood (OpenMeteo / GloFAS) ─────────────────────────────────────────────
// Daily simulated river discharge for the nearest supported river/grid cell.

model FloodForecast {
  id                    String   @id @default(cuid())
  districtId            String
  district              District @relation(fields: [districtId], references: [id])
  lat                   Float
  lng                   Float
  forecastDate          DateTime
  riverDischarge        Float?
  riverDischargeMean    Float?
  riverDischargeMedian  Float?
  riverDischargeMax     Float?
  riverDischargeMin     Float?
  riverDischargeP25     Float?
  riverDischargeP75     Float?
  createdAt             DateTime @default(now())

  @@unique([districtId, forecastDate])
  @@index([districtId])
  @@index([forecastDate])
}

// ─── Weather ──────────────────────────────────────────────────────────────────
// Keyed by district (not raw lat/lng) since every fetch targets a known district;
// lat/lng are kept for provenance only.

model CurrentWeatherReading {
  id                  String   @id @default(cuid())
  districtId          String
  district            District @relation(fields: [districtId], references: [id])
  lat                 Float
  lng                 Float
  readingTime         DateTime
  temperature2m       Float?
  relativeHumidity2m  Int?
  apparentTemperature Float?
  windSpeed10m        Float?
  windDirection10m    Int?
  precipitation       Float?
  weatherCode         Int?
  cloudCover          Int?
  isDay               Boolean?
  createdAt           DateTime @default(now())

  @@unique([districtId, readingTime])
  @@index([districtId])
}

model HourlyWeatherForecast {
  id                       String   @id @default(cuid())
  districtId               String
  district                 District @relation(fields: [districtId], references: [id])
  lat                      Float
  lng                      Float
  forecastTime             DateTime
  temperature2m            Float?
  relativeHumidity2m       Int?
  apparentTemperature      Float?
  precipitationProbability Int?
  precipitation            Float?
  weatherCode              Int?
  windSpeed10m             Float?
  windDirection10m         Int?
  cloudCover               Int?
  createdAt                DateTime @default(now())

  @@unique([districtId, forecastTime])
  @@index([districtId])
}

model DailyWeatherForecast {
  id                          String   @id @default(cuid())
  districtId                  String
  district                    District @relation(fields: [districtId], references: [id])
  lat                         Float
  lng                         Float
  forecastDate                DateTime @db.Date
  weatherCode                 Int?
  temperature2mMax            Float?
  temperature2mMin            Float?
  apparentTemperatureMax      Float?
  apparentTemperatureMin      Float?
  precipitationSum            Float?
  precipitationProbabilityMax Int?
  windSpeed10mMax             Float?
  uvIndexMax                  Float?
  sunrise                     DateTime?
  sunset                      DateTime?
  createdAt                   DateTime @default(now())

  @@unique([districtId, forecastDate])
  @@index([districtId])
}

model HourlyAirQuality {
  id               String   @id @default(cuid())
  districtId       String
  district         District @relation(fields: [districtId], references: [id])
  lat              Float
  lng              Float
  forecastTime     DateTime
  pm10             Float?
  pm25             Float?
  carbonMonoxide   Float?
  nitrogenDioxide  Float?
  sulphurDioxide   Float?
  ozone            Float?
  uvIndex          Float?
  createdAt        DateTime @default(now())

  @@unique([districtId, forecastTime])
  @@index([districtId])
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditEvent {
  id         String      @id @default(cuid())
  action     AuditAction
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  entityType String?
  entityId   String?
  meta       Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
}
