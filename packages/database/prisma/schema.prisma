generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  CITIZEN
  RESEARCHER
  ORGANIZATION_ADMIN
  GOVERNMENT
  MODERATOR
  ADMIN
}

enum OrganizationMemberRole {
  ADMIN
  MEMBER
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS_ONLY
  PRIVATE
}

enum AlertSeverity {
  INFO
  WATCH
  WARNING
  EMERGENCY
}

enum AlertStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  RESOLVED
}

enum ReportCategory {
  WATER_POLLUTION
  ILLEGAL_DUMPING
  DEFORESTATION
  WILDLIFE_INCIDENT
  FLOODING
  AIR_POLLUTION
  OTHER
}

enum DatasetCategory {
  WEATHER
  AIR_QUALITY
  WATER
  BIODIVERSITY
  REPORTS
  MONITORING
  GEOSPATIAL
}

enum DatasetAccessPolicy {
  PUBLIC
  LOGIN_REQUIRED
  RESEARCHER
  APPROVED
  GOVERNMENT
}

enum ProviderType {
  GOVERNMENT_AGENCY
  RESEARCH_INSTITUTION
  NGO
  INTERNATIONAL_ORG
  CITIZEN_SCIENCE
  SATELLITE
  IOT_SENSOR
}

enum OrganizationType {
  GOVERNMENT_AGENCY
  RESEARCH_INSTITUTION
  NGO
  COMMUNITY_GROUP
  PRIVATE_COMPANY
  INTERNATIONAL_ORG
  OTHER
}

enum IngestionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PollutionSourceType {
  FACTORY
  POWER_PLANT
  VEHICLE_FLEET
  AGRICULTURE
  CONSTRUCTION
  WASTE_FACILITY
  OTHER
}

enum PollutantType {
  CO2
  CH4
  N2O
  PM25
  PM10
  NOX
  SOX
  VOC
  CO
  OTHER
}

enum EmissionUnit {
  TONS_PER_YEAR
  KG_PER_DAY
  GRAMS_PER_HOUR
  MG_PER_M3
  OTHER
}

enum AuditAction {
  USER_REGISTER
  USER_LOGIN
  USER_LOGIN_FAILED
  USER_LOGOUT
  USER_ROLE_CHANGE
  USER_DEACTIVATE
  REPORT_SUBMIT
  REPORT_STATUS_CHANGE
  REPORT_COMMENT_ADD
  REPORT_MEDIA_ADD
  ALERT_CREATE
  ALERT_STATUS_CHANGE
  DATASET_ACCESS
  DATASET_DOWNLOAD
  DATASET_UPDATE
  OBSERVATION_SUBMIT
  OBSERVATION_TRUST_CHANGE
  OBSERVATION_UPDATE
  OBSERVATION_DELETE
  RESTORATION_PROJECT_CREATE
  RESTORATION_PROJECT_UPDATE
  RESTORATION_PROJECT_JOIN
  DATASET_ACCESS_DECISION
  PERMISSION_GRANT
  PERMISSION_REVOKE
  EMISSION_SOURCE_CREATE
  EMISSION_ENTRY_CREATE
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
}

enum DatasetAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  PAUSED
}

enum RestorationCategory {
  TREE_PLANTING
  WETLAND_RESTORATION
  RIVERBANK_PROTECTION
  MANGROVE
  WASTE_MANAGEMENT
  OTHER
}

enum ObservationCategory {
  BIODIVERSITY
  WATER_QUALITY
  AIR_QUALITY
  LAND_USE
  RESTORATION
}

enum ObservationTrustLevel {
  RESEARCH_GRADE
  COMMUNITY
  UNVERIFIED
  FLAGGED
}

enum NotificationChannel {
  EMAIL
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  displayName      String
  passwordHash     String
  role             UserRole @default(CITIZEN)
  isActive         Boolean  @default(true)
  isEmailVerified  Boolean  @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reports    CitizenReport[]
  observations Observation[]
  auditEvents AuditEvent[]
  refreshTokens RefreshToken[]
  restorationProjectsCreated RestorationProject[]
  restorationParticipations  RestorationParticipant[]
  datasetAccessRequests DatasetAccessRequest[] @relation("DatasetAccessRequester")
  datasetAccessDecisions DatasetAccessRequest[] @relation("DatasetAccessDecider")
  alertSubscriptions    AlertSubscription[]
  notificationDeliveries NotificationDelivery[]
  reportComments ReportComment[]
  reportMedia    ReportMedia[]
  organizationMemberships OrganizationMembership[]
  profile UserProfile?
  socialLinks UserSocialLink[]
  pollutionSourcesCreated PollutionSource[]
  emissionEntriesReported EmissionEntry[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([email])
  @@index([role])
}

model UserProfile {
  id                 String            @id @default(cuid())
  userId             String            @unique
  phone              String?
  preferredLanguage  String            @default("en")
  occupation         String?
  bio                String?
  expertise          String[]          @default([])
  researchInterests  String[]          @default([])
  education          String?
  institution        String?
  locationDistrict   String?
  locationCountry    String            @default("Bangladesh")
  profileVisibility  ProfileVisibility @default(PUBLIC)
  contactVisibility  ProfileVisibility @default(PRIVATE)
  linksVisibility    ProfileVisibility @default(PUBLIC)
  // ── Gamification ────────────────────────────────────────────────────────
  earnedBadges       String[]          @default([])
  contributionPoints Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSocialLink {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceId   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Organizations ────────────────────────────────────────────────────────────

model Organization {
  id          String       @id @default(cuid())
  name        String
  type        OrganizationType
  description String?
  website     String?
  country     String       @default("Bangladesh")
  isVerified  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  providers Provider[]
  restorationProjects RestorationProject[]
  memberships OrganizationMembership[]
  pollutionSources PollutionSource[]
}

model OrganizationMembership {
  id             String                  @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationMemberRole @default(MEMBER)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

// ─── Providers ────────────────────────────────────────────────────────────────

model Provider {
  id             String       @id @default(cuid())
  name           String
  type           ProviderType
  country        String       @default("Bangladesh")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  datasets       Dataset[]
  ingestionJobs  IngestionJob[]
}

// ─── Geography ────────────────────────────────────────────────────────────────

model Division {
  id        String     @id @default(cuid())
  name      String     @unique
  bnName    String?
  slug      String?
  pcode     String?    @unique
  lat       Float?
  lng       Float?
  areaSqKm  Float?
  url       String?

  // 30-day rolling climate averages (aggregated bottom-up from unions)
  avgTemp30d       Float?
  minTemp30d       Float?
  maxTemp30d       Float?
  avgHumidity30d   Float?
  totalPrecip30d   Float?
  avgWindSpeed30d  Float?
  avgCloudCover30d Float?
  avgPm25_30d      Float?
  avgPm10_30d      Float?
  avgUvIndex30d    Float?
  climateUpdatedAt DateTime?

  districts District[]
}

model District {
  id         String   @id @default(cuid())
  name       String
  bnName     String?
  slug       String?
  pcode      String?  @unique
  lat        Float?
  lng        Float?
  centerLat  Float?
  centerLng  Float?
  areaSqKm   Float?
  url        String?
  boundary   Json?
  isCoastal  Boolean  @default(false)
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])

  // 30-day rolling climate averages (aggregated bottom-up from unions)
  avgTemp30d       Float?
  minTemp30d       Float?
  maxTemp30d       Float?
  avgHumidity30d   Float?
  totalPrecip30d   Float?
  avgWindSpeed30d  Float?
  avgCloudCover30d Float?
  avgPm25_30d      Float?
  avgPm10_30d      Float?
  avgUvIndex30d    Float?
  climateUpdatedAt DateTime?

  upazilas Upazila[]
  reports  CitizenReport[]
  alerts   Alert[]
  observations Observation[]
  restorationProjects RestorationProject[]
  occurrences Occurrence[]
  alertSubscriptions AlertSubscription[]

  currentWeatherReadings    CurrentWeatherReading[]
  hourlyWeatherForecasts    HourlyWeatherForecast[]
  dailyWeatherForecasts     DailyWeatherForecast[]
  airQualityReadings        HourlyAirQuality[]
  floodForecasts            FloodForecast[]
  satelliteRadiationReadings SatelliteRadiationReading[]
  marineForecasts            MarineForecast[]
  pollutionSources           PollutionSource[]

  @@unique([name, divisionId])
  @@index([divisionId])
}

model Upazila {
  id         String   @id @default(cuid())
  name       String
  bnName     String?
  slug       String?
  pcode      String?  @unique
  lat        Float?
  lng        Float?
  areaSqKm   Float?
  url        String?
  districtId String
  district   District @relation(fields: [districtId], references: [id])

  // 30-day rolling climate averages (aggregated bottom-up from unions)
  avgTemp30d       Float?
  minTemp30d       Float?
  maxTemp30d       Float?
  avgHumidity30d   Float?
  totalPrecip30d   Float?
  avgWindSpeed30d  Float?
  avgCloudCover30d Float?
  avgPm25_30d      Float?
  avgPm10_30d      Float?
  avgUvIndex30d    Float?
  climateUpdatedAt DateTime?

  unions Union[]

  @@unique([name, districtId])
  @@index([districtId])
}

model Union {
  id        String  @id @default(cuid())
  name      String
  bnName    String?
  slug      String?
  pcode     String? @unique
  lat       Float?
  lng       Float?
  url       String?
  isCoastal Boolean @default(false)
  upazilaId String
  upazila   Upazila @relation(fields: [upazilaId], references: [id])

  // 30-day rolling climate averages (fetched directly from OpenMeteo at union lat/lng)
  avgTemp30d       Float?
  minTemp30d       Float?
  maxTemp30d       Float?
  avgHumidity30d   Float?
  totalPrecip30d   Float?
  avgWindSpeed30d  Float?
  avgCloudCover30d Float?
  avgPm25_30d      Float?
  avgPm10_30d      Float?
  avgUvIndex30d    Float?
  climateUpdatedAt DateTime?

  dailyClimate UnionDailyClimate[]

  @@unique([name, upazilaId])
  @@index([upazilaId])
}

// Daily climate history per union — used to compute 30-day rolling averages
model UnionDailyClimate {
  id           String   @id @default(cuid())
  unionId      String
  union        Union    @relation(fields: [unionId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  avgTemp      Float?
  minTemp      Float?
  maxTemp      Float?
  avgHumidity  Float?
  totalPrecip  Float?
  avgWindSpeed Float?
  maxWindSpeed Float?
  avgCloudCover Float?
  avgPm25      Float?
  avgPm10      Float?
  avgUvIndex   Float?
  avgOzone     Float?
  fetchedAt    DateTime @default(now())

  @@unique([unionId, date])
  @@index([unionId])
  @@index([date])
}

// ─── Datasets ─────────────────────────────────────────────────────────────────

model Dataset {
  id           String              @id @default(cuid())
  name         String
  category     DatasetCategory
  accessPolicy DatasetAccessPolicy @default(PUBLIC)
  source       String
  providerId   String?
  provider     Provider?           @relation(fields: [providerId], references: [id])
  description  String?
  recordCount  Int?
  lastSyncedAt DateTime?
  isPublished  Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  accessRequests DatasetAccessRequest[]

  @@index([providerId])
  @@index([category])
  @@index([accessPolicy])
}

model DatasetAccessRequest {
  id          String                     @id @default(cuid())
  datasetId   String
  dataset     Dataset                    @relation(fields: [datasetId], references: [id])
  userId      String
  user        User                       @relation("DatasetAccessRequester", fields: [userId], references: [id], onDelete: Cascade)
  status      DatasetAccessRequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?                      @relation("DatasetAccessDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([datasetId, userId])
}

// ─── Reports ──────────────────────────────────────────────────────────────────

model CitizenReport {
  id          String         @id @default(cuid())
  title       String
  description String
  category    ReportCategory @default(OTHER)
  status      ReportStatus   @default(SUBMITTED)
  summary     String?
  reporterId  String?
  reporter    User?          @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  districtId  String?
  district    District?      @relation(fields: [districtId], references: [id])
  lat         Float?
  lng         Float?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  statusHistory ReportStatusEvent[]
  comments      ReportComment[]
  media         ReportMedia[]

  @@index([reporterId])
  @@index([status])
  @@index([category])
  @@index([districtId])
  @@index([createdAt])
}

model ReportStatusEvent {
  id        String       @id @default(cuid())
  reportId  String
  report    CitizenReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status    ReportStatus
  note      String?
  createdAt DateTime     @default(now())

  @@index([reportId])
}

model ReportComment {
  id         String        @id @default(cuid())
  reportId   String
  report     CitizenReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId   String
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String        @db.Text
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([reportId])
  @@index([authorId])
}

model ReportMedia {
  id           String        @id @default(cuid())
  reportId     String
  report       CitizenReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User          @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  url          String
  mimeType     String?
  fileSize     Int?
  caption      String?
  createdAt    DateTime      @default(now())

  @@index([reportId])
}

// ─── Observations ─────────────────────────────────────────────────────────────

model Observation {
  id          String                 @id @default(cuid())
  category    ObservationCategory
  trustLevel  ObservationTrustLevel  @default(UNVERIFIED)
  description String
  observerId  String?
  observer    User?                  @relation(fields: [observerId], references: [id], onDelete: SetNull)
  districtId  String?
  district    District?              @relation(fields: [districtId], references: [id])
  lat         Float?
  lng         Float?
  species     String?
  observedAt  DateTime               @default(now())
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([observerId])
  @@index([category])
  @@index([trustLevel])
  @@index([districtId])
}

// ─── Restoration Projects ──────────────────────────────────────────────────────

model RestorationProject {
  id             String               @id @default(cuid())
  title          String
  description    String
  category       RestorationCategory
  status         ProjectStatus        @default(PLANNED)
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id])
  districtId     String?
  district       District?            @relation(fields: [districtId], references: [id])
  startDate      DateTime?
  endDate        DateTime?
  impactSummary  String?
  createdById    String
  createdBy      User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  participants RestorationParticipant[]

  @@index([category])
  @@index([status])
  @@index([districtId])
}

model RestorationParticipant {
  id        String             @id @default(cuid())
  projectId String
  project   RestorationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime           @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

// ─── Biodiversity (GBIF) ───────────────────────────────────────────────────────

model Species {
  id              String   @id @default(cuid())
  gbifKey         Int      @unique
  canonicalName   String
  vernacularName  String?
  kingdom         String?
  phylum          String?
  class           String?
  order           String?
  family          String?
  genus           String?
  iucnStatus      String?
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  occurrences Occurrence[]

  @@index([canonicalName])
}

model Occurrence {
  id                String    @id @default(cuid())
  gbifOccurrenceKey BigInt    @unique
  speciesId         String
  species           Species   @relation(fields: [speciesId], references: [id])
  districtId        String?
  district          District? @relation(fields: [districtId], references: [id])
  lat               Float
  lng               Float
  observedAt        DateTime?
  recordedBy        String?
  basisOfRecord     String?
  createdAt         DateTime  @default(now())

  @@index([speciesId])
  @@index([districtId])
}

// ─── Alerts ───────────────────────────────────────────────────────────────────

model Alert {
  id           String        @id @default(cuid())
  title        String
  description  String
  severity     AlertSeverity @default(INFO)
  status       AlertStatus   @default(DRAFT)
  instructions String?
  districtId   String?
  district     District?     @relation(fields: [districtId], references: [id])
  issuedAt     DateTime      @default(now())
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  deliveries NotificationDelivery[]

  @@index([status])
  @@index([severity])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model AlertSubscription {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  districtId  String?
  // null = nationwide subscription (receives alerts for any district)
  district    District?           @relation(fields: [districtId], references: [id])
  channel     NotificationChannel @default(EMAIL)
  // Minimum alert severity to trigger delivery. A subscriber with minSeverity
  // WARNING receives WARNING and EMERGENCY alerts only.
  minSeverity AlertSeverity       @default(INFO)
  createdAt   DateTime            @default(now())

  // No @@unique here: Postgres treats NULL != NULL in unique indexes, so
  // @@unique([userId, districtId, channel]) would allow duplicate global
  // (districtId IS NULL) subscriptions per user. Uniqueness is enforced in
  // NotificationsService.subscribe() instead.
  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([districtId])
}

model NotificationDelivery {
  id             String              @id @default(cuid())
  subscriptionId String
  // Cascade: deleting a subscription removes its delivery history.
  subscription   AlertSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  alertId        String
  alert          Alert               @relation(fields: [alertId], references: [id])
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  // Address captured at send time — preserved even if the user later changes email.
  address        String
  status         DeliveryStatus      @default(PENDING)
  sentAt         DateTime?
  failedAt       DateTime?
  error          String?
  createdAt      DateTime            @default(now())

  @@index([alertId])
  @@index([userId])
  @@index([status])
}

// ─── Ingestion ────────────────────────────────────────────────────────────────

model IngestionJob {
  id         String          @id @default(cuid())
  providerId String
  provider   Provider        @relation(fields: [providerId], references: [id])
  status     IngestionStatus @default(QUEUED)
  startedAt  DateTime?
  endedAt    DateTime?
  errorMsg   String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([providerId])
  @@index([status])
}

// ─── Flood (OpenMeteo / GloFAS) ─────────────────────────────────────────────
// Daily simulated river discharge for the nearest supported river/grid cell.

model FloodForecast {
  id                    String   @id @default(cuid())
  districtId            String
  district              District @relation(fields: [districtId], references: [id])
  lat                   Float
  lng                   Float
  forecastDate          DateTime
  riverDischarge        Float?
  riverDischargeMean    Float?
  riverDischargeMedian  Float?
  riverDischargeMax     Float?
  riverDischargeMin     Float?
  riverDischargeP25     Float?
  riverDischargeP75     Float?
  createdAt             DateTime @default(now())

  @@unique([districtId, forecastDate])
  @@index([districtId])
  @@index([forecastDate])
}

// ─── Marine Weather (OpenMeteo Marine API) ───────────────────────────────────
// Daily wave, swell, and wind-wave forecasts for each district's nearest marine grid cell.
// Wave heights in metres; directions in degrees; periods in seconds.
// Inland districts will have no rows — the marine API only resolves sea grid cells.

model MarineForecast {
  id                        String   @id @default(cuid())
  districtId                String
  district                  District @relation(fields: [districtId], references: [id])
  lat                       Float
  lng                       Float
  forecastDate              DateTime @db.Date
  waveHeightMax             Float?
  waveDirectionDominant     Float?
  wavePeriodMax             Float?
  windWaveHeightMax         Float?
  windWaveDirectionDominant Float?
  windWavePeriodMax         Float?
  windWavePeakPeriodMax     Float?
  swellWaveHeightMax        Float?
  swellWaveDirectionDominant Float?
  swellWavePeriodMax        Float?
  swellWavePeakPeriodMax    Float?
  createdAt                 DateTime @default(now())

  @@unique([districtId, forecastDate])
  @@index([districtId])
  @@index([forecastDate])
}

// ─── Satellite Radiation (OpenMeteo Satellite API) ───────────────────────────
// Daily solar radiation totals and sunshine for each district.
// shortwaveRadiationSum in Wh/m²; sunshineDuration and daylightDuration in seconds.

model SatelliteRadiationReading {
  id                    String   @id @default(cuid())
  districtId            String
  district              District @relation(fields: [districtId], references: [id])
  lat                   Float
  lng                   Float
  readingDate           DateTime @db.Date
  shortwaveRadiationSum Float?
  sunshineDuration      Float?
  daylightDuration      Float?
  createdAt             DateTime @default(now())

  @@unique([districtId, readingDate])
  @@index([districtId])
  @@index([readingDate])
}

// ─── Weather ──────────────────────────────────────────────────────────────────
// Keyed by district (not raw lat/lng) since every fetch targets a known district;
// lat/lng are kept for provenance only.

model CurrentWeatherReading {
  id                  String   @id @default(cuid())
  districtId          String
  district            District @relation(fields: [districtId], references: [id])
  lat                 Float
  lng                 Float
  readingTime         DateTime
  temperature2m       Float?
  relativeHumidity2m  Int?
  apparentTemperature Float?
  windSpeed10m        Float?
  windDirection10m    Int?
  precipitation       Float?
  weatherCode         Int?
  cloudCover          Int?
  isDay               Boolean?
  createdAt           DateTime @default(now())

  @@unique([districtId, readingTime])
  @@index([districtId])
}

model HourlyWeatherForecast {
  id                       String   @id @default(cuid())
  districtId               String
  district                 District @relation(fields: [districtId], references: [id])
  lat                      Float
  lng                      Float
  forecastTime             DateTime
  temperature2m            Float?
  relativeHumidity2m       Int?
  apparentTemperature      Float?
  precipitationProbability Int?
  precipitation            Float?
  weatherCode              Int?
  windSpeed10m             Float?
  windDirection10m         Int?
  cloudCover               Int?
  createdAt                DateTime @default(now())

  @@unique([districtId, forecastTime])
  @@index([districtId])
}

model DailyWeatherForecast {
  id                          String   @id @default(cuid())
  districtId                  String
  district                    District @relation(fields: [districtId], references: [id])
  lat                         Float
  lng                         Float
  forecastDate                DateTime @db.Date
  weatherCode                 Int?
  temperature2mMax            Float?
  temperature2mMin            Float?
  apparentTemperatureMax      Float?
  apparentTemperatureMin      Float?
  precipitationSum            Float?
  precipitationProbabilityMax Int?
  windSpeed10mMax             Float?
  uvIndexMax                  Float?
  sunrise                     DateTime?
  sunset                      DateTime?
  createdAt                   DateTime @default(now())

  @@unique([districtId, forecastDate])
  @@index([districtId])
}

model HourlyAirQuality {
  id               String   @id @default(cuid())
  districtId       String
  district         District @relation(fields: [districtId], references: [id])
  lat              Float
  lng              Float
  forecastTime     DateTime
  pm10             Float?
  pm25             Float?
  carbonMonoxide   Float?
  nitrogenDioxide  Float?
  sulphurDioxide   Float?
  ozone            Float?
  uvIndex          Float?
  createdAt        DateTime @default(now())

  @@unique([districtId, forecastTime])
  @@index([districtId])
}

// ─── Emissions ────────────────────────────────────────────────────────────────
// Source-level pollution tracking — distinct from ambient HourlyAirQuality readings.

model PollutionSource {
  id             String            @id @default(cuid())
  name           String
  type           PollutionSourceType
  description    String?
  districtId     String?
  district       District?         @relation(fields: [districtId], references: [id])
  lat            Float?
  lng            Float?
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  isActive       Boolean           @default(true)
  createdById    String
  createdBy      User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  entries EmissionEntry[]

  @@index([districtId])
  @@index([type])
  @@index([isActive])
}

model EmissionEntry {
  id                String        @id @default(cuid())
  sourceId          String
  source            PollutionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  pollutant         PollutantType
  value             Float
  unit              EmissionUnit
  measurementMethod String?
  periodStart       DateTime?
  periodEnd         DateTime?
  notes             String?
  reportedById      String?
  reportedBy        User?         @relation(fields: [reportedById], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([sourceId])
  @@index([pollutant])
}

// ─── Permissions ──────────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model AuditEvent {
  id         String      @id @default(cuid())
  action     AuditAction
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  entityType String?
  entityId   String?
  meta       Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
}
