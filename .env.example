# Used by local dev commands: pnpm db:migrate, pnpm db:push, pnpm dev, etc.
DATABASE_URL="postgresql://nature_grid:nature_grid@localhost:5432/nature_grid?schema=public"

# Used by the API Docker container (docker-compose up).
# Same as DATABASE_URL but with host.docker.internal instead of localhost —
# inside the container, localhost resolves to the container itself, not the host.
DOCKER_DATABASE_URL="postgresql://nature_grid:nature_grid@host.docker.internal:5432/nature_grid?schema=public"

REDIS_URL="redis://localhost:6379"

# Required. The API refuses to start without this, and rejects placeholder
# values or anything under 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=""

PORT=3001

# Required in production. Comma-separated list of allowed CORS origins.
# The API will refuse to start in production if this is not set.
# Example: "https://naturegrid.bd,https://admin.naturegrid.bd"
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"

NODE_ENV="development"

# ─── Production admin bootstrap (one-time) ────────────────────────────────────
# Set these only on your FIRST production deploy to create the initial admin
# account. Once the account exists, remove both vars from your deployment env.
# BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
# BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-strong-password

# ─── Email / SMTP (optional) ──────────────────────────────────────────────────
# All SMTP vars are optional. When SMTP_HOST is not set the API starts normally
# but email delivery is disabled — alert notifications are silently skipped.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASS=changeme
# SMTP_FROM="Nature Grid Alerts <alerts@naturegrid.bd>"

